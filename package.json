{
  "name": "website-alaankwa",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "npm run build && webpack-dev-server",
    "build": "npm run lint && npm run format && tsc && webpack",
    "lint": "eslint \"src/**/*.{cjs,mjs,js,jsx,ts,tsx,mts,cts}\" --quiet --fix",
    "format": "prettier --write \"src/**/*.{cjs,mjs,js,jsx,ts,tsx,mts,cts,json,html,css}\"",
    "update": "ncu -u"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/cli": "^7.28.3",
    "@babel/core": "^7.28.3",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@types/lodash": "^4.17.20",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "babel-loader": "^10.0.0",
    "css-loader": "^7.1.2",
    "eslint": "^9.34.0",
    "html-webpack-plugin": "^5.6.4",
    "npm-check-updates": "^18.0.3",
    "prettier": "^3.6.2",
    "style-loader": "^4.0.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  }
}
